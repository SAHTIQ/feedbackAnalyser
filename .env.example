# FeedbackIQ Environment Configuration

# Database
# Default to SQLite for zero-setup local dev/tests, or configure Supabase/PostgreSQL:
DATABASE_URL=sqlite:///./feedbackiq.db
# Example PostgreSQL: postgresql://postgres:password@localhost:5432/feedbackiq
# Example Supabase: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Authentication & Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-or-any-secret-for-local-dev
JWT_ALGORITHM=HS256

# AI / LLM Configuration
# Options: mock, google, openai, anthropic
LLM_PROVIDER=mock
LLM_MODEL=gemini-2.5-flash
# Provider API Keys
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Scheduling & System
SCHEDULE_INTERVAL_DAYS=7
LOG_LEVEL=INFO
APP_ENV=development
